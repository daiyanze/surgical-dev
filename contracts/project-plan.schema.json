{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "Surgical Dev basic project plan record — shape, not authorization",
  "description": "Local planning record. Validation does not authenticate authorization, resolve dependency artifacts, or prove integration. Dependency acyclicity is checked by tests.",
  "properties": {
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "plan_revision": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "DRAFT",
        "PLANNING",
        "EXECUTING",
        "INTEGRATING",
        "INTEGRATION_VERIFYING",
        "PR_READY",
        "BLOCKED"
      ]
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "authorization_ref": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "integration_owner_ref": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "project_acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "workstreams": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/workstream"
      }
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "checks",
        "snapshot",
        "verdict"
      ],
      "properties": {
        "target": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "snapshot": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "verdict": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "note": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "not": {
              "const": "DRAFT"
            }
          }
        }
      },
      "then": {
        "properties": {
          "authorization_ref": {
            "type": "string",
            "minLength": 1
          },
          "integration_owner_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "workstream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workstream_id",
        "objective",
        "depends_on",
        "dependency_snapshots",
        "write_paths",
        "shared_resources",
        "acceptance_criteria",
        "assignee_execution_ref"
      ],
      "properties": {
        "workstream_id": {
          "type": "string",
          "minLength": 1
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "dependency_snapshots": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "write_paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "shared_resources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "assignee_execution_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  },
  "required": [
    "project_id",
    "plan_id",
    "plan_revision",
    "status",
    "goal",
    "authorization_ref",
    "integration_owner_ref",
    "project_acceptance_criteria",
    "workstreams",
    "integration"
  ]
}
