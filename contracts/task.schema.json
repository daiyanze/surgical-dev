{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "Surgeon task record v1 \u2014 shape, not authorization",
  "description": "Local coordination record. Validation does not authenticate approvals or verify real evidence.",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "repo": {
      "type": "string",
      "minLength": 1
    },
    "scope_revision": {
      "type": "string",
      "minLength": 1
    },
    "scope_snapshot": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "approval_source": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "base_sha": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        {
          "type": "null"
        }
      ]
    },
    "head_sha": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        {
          "type": "null"
        }
      ]
    },
    "run_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "BRIEF",
        "IMPLEMENTING",
        "VERIFYING",
        "PR_READY",
        "BLOCKED"
      ]
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "condition"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AC-[0-9]+$"
          },
          "condition": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "non_goals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "allowed_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "required_checks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "check_evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "review_evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "fix_cycles_used": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "blocker": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reason",
            "owner",
            "resume_condition"
          ],
          "properties": {
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "owner": {
              "type": "string",
              "minLength": 1
            },
            "resume_condition": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "resume_from": {
      "enum": [
        null,
        "BRIEF",
        "IMPLEMENTING",
        "VERIFYING",
        "PR_READY"
      ]
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "IMPLEMENTING",
              "VERIFYING",
              "PR_READY"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "scope_snapshot": {
            "type": "string",
            "minLength": 1
          },
          "approval_source": {
            "type": "string",
            "minLength": 1
          },
          "acceptance_criteria": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "VERIFYING",
              "PR_READY"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "base_sha": {
            "type": "string",
            "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
          },
          "head_sha": {
            "type": "string",
            "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
          },
          "run_id": {
            "type": "string",
            "minLength": 1
          },
          "check_evidence": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "PR_READY"
          }
        }
      },
      "then": {
        "properties": {
          "review_evidence": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "BLOCKED"
          }
        }
      },
      "then": {
        "properties": {
          "blocker": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reason",
              "owner",
              "resume_condition"
            ],
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "resume_condition": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "resume_from": {
            "enum": [
              "BRIEF",
              "IMPLEMENTING",
              "VERIFYING",
              "PR_READY"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "blocker": {
            "type": "null"
          },
          "resume_from": {
            "type": "null"
          }
        }
      }
    }
  ],
  "required": [
    "schema_version",
    "task_id",
    "repo",
    "scope_revision",
    "scope_snapshot",
    "approval_source",
    "base_sha",
    "head_sha",
    "run_id",
    "status",
    "acceptance_criteria",
    "non_goals",
    "allowed_actions",
    "required_checks",
    "check_evidence",
    "review_evidence",
    "fix_cycles_used",
    "blocker",
    "resume_from",
    "next_action"
  ]
}
