{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "Surgical Dev basic independent review report \u2014 shape only",
  "description": "A valid report is not proof that the named session ran or evidence is true. The host/human must establish those facts.",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "repo": {
      "type": "string",
      "minLength": 1
    },
    "scope_revision": {
      "type": "string",
      "minLength": 1
    },
    "base_sha": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        {
          "type": "null"
        }
      ]
    },
    "head_sha": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        {
          "type": "null"
        }
      ]
    },
    "verdict": {
      "enum": [
        "PASS",
        "CHANGES_REQUIRED",
        "BLOCKED"
      ]
    },
    "reviewer_session_ref": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "required_check_status": {
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN"
      ]
    },
    "check_evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "acceptance_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "result",
          "evidence_refs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AC-[0-9]+$"
          },
          "result": {
            "enum": [
              "PASS",
              "FAIL",
              "UNKNOWN"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    },
    "blocking_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "location",
          "evidence",
          "impact",
          "clearance_condition"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "impact": {
            "type": "string",
            "minLength": 1
          },
          "clearance_condition": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "non_blocking_suggestions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "remaining_risks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "blocked_reason": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "review_scope": {
      "enum": [
        "STREAM",
        "INTEGRATION"
      ],
      "default": "STREAM"
    },
    "plan_revision": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "workstream_snapshots": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "properties": {
          "base_sha": {
            "type": "string",
            "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
          },
          "head_sha": {
            "type": "string",
            "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
          },
          "reviewer_session_ref": {
            "type": "string",
            "minLength": 1
          },
          "required_check_status": {
            "const": "PASS"
          },
          "check_evidence": {
            "minItems": 1
          },
          "acceptance_results": {
            "minItems": 1,
            "items": {
              "properties": {
                "result": {
                  "const": "PASS"
                },
                "evidence_refs": {
                  "minItems": 1
                }
              }
            }
          },
          "blocking_findings": {
            "maxItems": 0
          },
          "blocked_reason": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "CHANGES_REQUIRED"
          }
        }
      },
      "then": {
        "properties": {
          "blocking_findings": {
            "minItems": 1
          },
          "blocked_reason": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "BLOCKED"
          }
        }
      },
      "then": {
        "properties": {
          "blocked_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "review_scope",
          "verdict"
        ],
        "properties": {
          "review_scope": {
            "const": "INTEGRATION"
          },
          "verdict": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "required": [
          "plan_revision",
          "workstream_snapshots"
        ],
        "properties": {
          "plan_revision": {
            "type": "string",
            "minLength": 1
          },
          "workstream_snapshots": {
            "type": "object",
            "minProperties": 1
          }
        }
      }
    }
  ],
  "required": [
    "schema_version",
    "task_id",
    "repo",
    "scope_revision",
    "base_sha",
    "head_sha",
    "verdict",
    "reviewer_session_ref",
    "required_check_status",
    "check_evidence",
    "acceptance_results",
    "blocking_findings",
    "non_blocking_suggestions",
    "remaining_risks",
    "blocked_reason"
  ]
}
