{
  "name": "surgical-dev",
  "version": "0.3.0-content",
  "private": true,
  "description": "Goal-driven software methods as portable Agent Skills, with an automatic development, verification and repair loop for Pi only.",
  "type": "module",
  "keywords": [
    "pi-package",
    "agent-skills",
    "software-development"
  ],
  "pi": {
    "skills": [
      "./skills"
    ],
    "extensions": [
      "./adapters/pi/extensions/surgical.ts"
    ]
  },
  "files": [
    "README.md",
    "VALIDATION.md",
    "roles",
    "skills",
    "references",
    "templates",
    "contracts",
    "examples",
    "adapters",
    "docs",
    "ARCHITECTURE.en.md",
    "ARCHITECTURE.zh-CN.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "sync": "node scripts/sync-skill-references.mjs",
    "sync:check": "node scripts/sync-skill-references.mjs --check",
    "test:pi-host": "node --test tests/pi-host-smoke.mjs"
  },
  "devDependencies": {
    "ajv": "^8.20.0"
  }
}
