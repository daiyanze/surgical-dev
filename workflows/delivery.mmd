flowchart TD
    I["Accepted opportunity or direct request"] --> B["Engineer: bounded brief and original authorization"]
    B --> Q{"Scope Ready?"}
    Q -->|"No"| H["Clarify or seek admission"]
    H --> B
    Q -->|"Yes"| E["Implement, test, debug<br/>Same coding session"]
    E -.->|"Optional"| W["Bounded temporary subagent"]
    W -.->|"Return evidence"| E
    E --> C["Actual local checks and authorized draft-PR CI"]
    C --> G{"Checks Passed?"}
    G -->|"Failed, budget remains"| E
    G -->|"Unknown or exhausted"| X["BLOCKED or ESCALATED<br/>Save prior stage and recovery condition"]
    G -->|"Yes"| V["Independent Verifier on pinned snapshot"]
    V --> D{"Verdict"}
    D -->|"BLOCKED"| X
    D -->|"CHANGES_REQUIRED"| R{"Repair budget remains?"}
    R -->|"Yes"| F["Invalidate old evidence<br/>Repair and recheck"]
    F --> E
    R -->|"No"| X
    D -->|"PASS"| P["PR_READY"]
    P --> T{"Delivery requested and authorized path available?"}
    T -->|"No"| STOP["Return PR and evidence<br/>No publication"]
    T -->|"Yes"| O["Operator: reconcile current review and delivery target"]
    O --> M{"Merge or build required first?"}
    M -->|"Yes"| MB["Authorized protected merge or build<br/>Observe actual result and provenance"]
    M -->|"No"| A["Pin candidate artifact, environment and configuration"]
    MB --> A
    A --> RR{"Release Ready and action authorized?"}
    RR -->|"No"| X
    RR -->|"Source change required"| B
    RR -->|"Yes"| RUN["Record intent and run approved operation"]
    RUN --> OBS["Read actual job, deployed version and observation checks"]
    OBS --> OK{"Outcome established?"}
    OK -->|"Unknown"| X
    OK -->|"Failed"| INC["Operator: incident handling and authorized containment"]
    OK -->|"Checks satisfied"| DONE["Record VERIFIED for stated checks and window"]
    INC -->|"Source repair required"| B
    DONE --> S["Scout: optional outcome assessment<br/>SUPPORTED, INCONCLUSIVE or REGRESSED"]
